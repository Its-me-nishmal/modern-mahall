{
    "preset": "ts-jest",
    "testEnvironment": "jsdom",
    "roots": [
        "<rootDir>"
    ],
    "testMatch": [
        "**/__tests__/**/*.+(ts|tsx|js)",
        "**/?(*.)+(spec|test).+(ts|tsx|js)"
    ],
    "transform": {
        "^.+\\.(ts|tsx)$": [
            "ts-jest",
            {
                "tsconfig": {
                    "jsx": "react",
                    "esModuleInterop": true,
                    "allowSyntheticDefaultImports": true
                }
            }
        ]
    },
    "moduleNameMapper": {
        "\\.(css|less|scss|sass)$": "identity-obj-proxy",
        "^@/(.*)$": "<rootDir>/$1"
    },
    "setupFilesAfterEnv": [
        "<rootDir>/jest.setup.ts"
    ],
    "collectCoverageFrom": [
        "**/*.{ts,tsx}",
        "!**/*.d.ts",
        "!**/node_modules/**",
        "!**/.next/**",
        "!**/dist/**",
        "!**/coverage/**",
        "!jest.config.js",
        "!jest.setup.ts"
    ],
    "coverageThreshold": {
        "global": {
            "branches": 50,
            "functions": 50,
            "lines": 50,
            "statements": 50
        }
    },
    "globals": {
        "ts-jest": {
            "isolatedModules": true
        }
    }
}