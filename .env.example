# ==========================================
# MODERN MAHALL - ENVIRONMENT CONFIGURATION
# ==========================================

# Database Configuration
# ----------------------
# DB_SYSTEM: Choose between 'mongodb' or 'filedb'
# - mongodb: Production-ready, scalable database
# - filedb: Simple JSON file storage (development only)
DB_SYSTEM=filedb

# MongoDB Configuration (only needed if DB_SYSTEM=mongodb)
MONGODB_URI=mongodb://localhost:27017/modern-mahall
# For MongoDB Atlas:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/modern-mahall?retryWrites=true&w=majority

# Server Configuration
# --------------------
PORT=3001
NODE_ENV=development

# Authentication Configuration
# ----------------------------
# Admin mobile number (Indian format: 91XXXXXXXXXX)
ADMIN_MOBILE=919876543210

# OTP Configuration
OTP_EXPIRY_MINUTES=5

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRY=7d

# Web Push Notifications (VAPID Keys)
# -----------------------------------
# Generate keys using: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your-vapid-public-key-here
VAPID_PRIVATE_KEY=your-vapid-private-key-here
VAPID_SUBJECT=mailto:admin@modernmahall.com

# AI Configuration (Optional)
# ---------------------------
# Get your API key from: https://ai.google.dev/
GEMINI_API_KEY=your-gemini-api-key-here

# Security (Production)
# ---------------------
# Comma-separated list of allowed origins for CORS
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# SMS Gateway Configuration (Optional)
# ------------------------------------
# For production OTP delivery
# SMS_API_KEY=your-sms-api-key
# SMS_PROVIDER=twilio|aws-sns|custom

# ==========================================
# QUICK START GUIDE
# ==========================================
# 1. Copy this file: cp .env.example .env.local
# 2. Update ADMIN_MOBILE with your mobile number
# 3. Generate VAPID keys: npx web-push generate-vapid-keys
# 4. (Optional) Add GEMINI_API_KEY for AI features
# 5. For production: Change JWT_SECRET and DB_SYSTEM=mongodb
